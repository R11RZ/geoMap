{
  "name": "tmp-map",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "src/electron.cjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=dev npm run dev:all",
    "dev:all": "concurrently -n=svelte,electron -c='#ff3e00',blue \"npm run dev:svelte\" \"npm run dev:electron\"",
    "dev:svelte": "vite dev",
    "dev:electron": "electron src/electron.cjs",
    "build": "cross-env NODE_ENV=production npm run build:svelte && npm run build:electron",
    "build:svelte": "vite build",
    "build:electron": "electron-builder -w --config build.config.json",
    "deploy" : "gh-pages -d build -t",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^0.577.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "gh-pages": "^6.3.0",
    "svelte": "^5.49.2",
    "svelte-check": "^4.3.6",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@tabler/icons-svelte": "^3.38.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron-context-menu": "^4.1.1",
    "electron-reloader": "^1.2.3",
    "electron-serve": "^3.0.1",
    "electron-window-state": "^5.0.3",
    "es-toolkit": "^1.45.1",
    "geojson": "^0.5.0",
    "leaflet.bigimage": "^1.0.1",
    "sveaflet": "^0.1.4",
    "svelte-preprocess": "^6.0.3",
    "uuid": "^13.0.0"
  }
}
